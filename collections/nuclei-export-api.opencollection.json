{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDCP agents export API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "export",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export filtered Scan results",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectdiscovery.io/v1/scans/results/export",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "async",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "json, csv, pdf (default json)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Export filtered scan results"
        },
        {
          "info": {
            "name": "Get export list for user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectdiscovery.io/v1/export/list",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of items to skip before starting to collect the result set"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "export_status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get export list for user"
        },
        {
          "info": {
            "name": "Export leaked credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectdiscovery.io/v1/leaks/export",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Export format (json or csv)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Export leaked credentials with filtering by type, domain, email, date range, and more. Passwords are unmasked after domain verification. See [Domain Verification](/cloud/credential-monitoring#domain-verification) for setup instructions."
        },
        {
          "info": {
            "name": "Export report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectdiscovery.io/v1/report/export",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "report_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "time",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Export report"
        }
      ]
    }
  ],
  "bundled": true
}