{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDCP agents billing API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the monthly billing cycle dates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectdiscovery.io/v1/billing-cycles",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ]
          },
          "docs": "Get the monthly billing cycle dates"
        }
      ]
    }
  ],
  "bundled": true
}